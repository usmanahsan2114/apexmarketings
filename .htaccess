# ========================================================================
# Apex Marketings — .htaccess
# Order: HTTPS + canonical host → security headers → compression →
#        expires/cache → directory & file blocks → error pages
# Canonical host: https://apexmarketings.com (non-www)
# ========================================================================

RewriteEngine On

# ---- Force HTTPS (skip localhost / 127.0.0.1 for local XAMPP work) ----
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- Force non-www (www → apex root) ----
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---- Consolidate duplicate pages (301 to canonical) ----
RewriteRule ^index\.(html|php)$ / [L,R=301]
RewriteRule ^portfolio/contact/?$ /contact/ [L,R=301]
RewriteRule ^portfolio/e-commerce-store-performances/?$ /portfolio/e-commerce-store-performance/ [L,R=301]
RewriteRule ^case-studies/altrgroup-com/?$ /case-studies/altr/ [L,R=301]
RewriteRule ^blogs/hiring-offshore-pakistan/?$ https://www.apexitsolutions.co/blogs/hiring-offshore-pakistan/ [L,R=301]

# ---- Self-healing partitioned sitemaps ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap-(pages|services|locations|posts)\.xml$ sitemap.php?type=$1 [L,QSA]

# Serve the static sitemap.xml / sitemap.html when present (fast path).
# If they are ever missing from the deployed root, generate them live via
# sitemap.php so /sitemap.xml never 404s and never goes stale.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap\.html$ sitemap.php [L]

# ========================================================================
# Security headers
# ========================================================================
<IfModule mod_headers.c>
  # Skip HSTS on localhost so local HTTP development is not pinned to HTTPS.
  SetEnvIfNoCase Host "^(localhost|127\.0\.0\.1)(:\d+)?$" is_dev_host=1
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=!is_dev_host
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>
ServerSignature Off

# ========================================================================
# Compression (gzip + brotli where available)
# ========================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml application/x-font-ttf font/opentype application/vnd.ms-fontobject
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ========================================================================
# Cache / expires
# ========================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML always fresh
  ExpiresByType text/html "access plus 0 seconds"

  # Styles & Scripts (1 Month)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"

  # Fonts (1 Year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Static Media (1 Year)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # XML/data
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|woff|ttf|otf|webp|jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ========================================================================
# Blocks (robots.txt also disallows these; this enforces server-side)
# ========================================================================

# Hidden files (.env, .gitignore, .htaccess, etc.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Docs, backups, logs, lead journals, dev scripts
<FilesMatch "\.(md|bak|log|jsonl|sql|sh|py)$">
  Require all denied
</FilesMatch>

# Sensitive directories (covers files INSIDE .git/, which the dot-file rule
# above does not reach because FilesMatch tests filenames only)
RewriteRule ^\.git(/|$) - [F,L]
RewriteRule ^\.codex(/|$) - [F,L]
RewriteRule ^_dev_archive(/|$) - [F,L]
RewriteRule ^include(/|$) - [F,L]
RewriteRule ^private(/|$) - [F,L]

# ========================================================================
# Redirects for retired URLs
# ========================================================================
# blog1 was an unfinished theme demo page; its slot is covered by /blogs/
RewriteRule ^blogs/blog1(/.*)?$ /blogs/ [R=301,L]
# portfolio/delivrex was theme demo (lorem ipsum); the real write-up lives in case studies
RewriteRule ^portfolio/delivrex(/.*)?$ /case-studies/delivrex/ [R=301,L]

# ========================================================================
# Custom error pages
# ========================================================================
ErrorDocument 404 /404.php
