# Deny all web access to the private directory (config, mail library, lead storage).
# Works on Apache 2.4 (Require) and 2.2 (Order/Deny) — XAMPP and most shared hosts.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
